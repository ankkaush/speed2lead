# Copy this file to .env and fill in real values locally.
# .env is gitignored and must never be committed. This file (.env.example)
# is committed and must never contain real secret values.

# --- App ---
APP_ENV=development

# --- Database (Postgres via Supabase) ---
DATABASE_URL=

# --- CRM (HubSpot private app access token) ---
HUBSPOT_ACCESS_TOKEN=

# --- Notification (Slack incoming webhook URL) ---
SLACK_WEBHOOK_URL=

# --- Acknowledgement email (Resend) ---
RESEND_API_KEY=

# --- Error tracking (Sentry) ---
SENTRY_DSN=

# --- Webhook signature verification (ADR 0010) ---
# Shared secret between this API and whatever server calls POST /leads. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SIGNING_SECRET=
